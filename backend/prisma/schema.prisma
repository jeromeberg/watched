generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum TitleType {
  MOVIE
  TV
}

enum WatchStatus {
  WATCHED
  TO_WATCH
}

model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  passwordHash   String
  bio            String?
  createdAt      DateTime       @default(now())
  titles         UserTitle[]
  collections    Collection[]
  topPicks       UserTopPick[]
}

model Title {
  id          Int       @id @default(autoincrement())
  tmdbId      Int
  type        TitleType
  title       String
  posterUrl   String?
  releaseYear Int?
  imdbId      String?
  director    String?
  description String?

  userTitles      UserTitle[]
  collectionItems CollectionItem[]
  topPicks        UserTopPick[]

  @@unique([tmdbId, type])
}

model UserTitle {
  userId  Int
  titleId Int
  rating  Int?
  status  WatchStatus @default(TO_WATCH)
  notes   String?
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  title Title @relation(fields: [titleId], references: [id])

  @@id([userId, titleId])
  @@index([userId, status])
  @@index([userId, addedAt])
  @@index([userId, status, addedAt])
}

model UserTopPick {
  userId  Int
  titleId Int
  rank    Int

  user  User  @relation(fields: [userId], references: [id])
  title Title @relation(fields: [titleId], references: [id])

  @@id([userId, rank])
  @@unique([userId, titleId])
}

model Collection {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  createdAt   DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id])
  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  collectionId Int
  titleId      Int
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  title      Title      @relation(fields: [titleId], references: [id])

  @@id([collectionId, titleId])
}
